# Stone Shop Flask - exemple de variables d'environnement.
# Copier en `.env` (qui est ignore par git) avant `docker compose up`.

FLASK_APP=main.py
FLASK_ENV=development
FLASK_DEBUG=1

# A regenerer avec : python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=changeme-32-chars-hex

# URI utilisee QUAND Flask tourne hors Docker (bouton Run vert PyCharm).
# 5433 = port hote expose par Stone-Shop/docker-compose.yaml.
# En mode Docker, le compose Flask override cette valeur avec db:5432.
SQLALCHEMY_DATABASE_URI=postgresql://postgres:changeme@localhost:5433/stone_shop

# Variables consommees par le service `db` du docker-compose
POSTGRES_DB=stone_shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
